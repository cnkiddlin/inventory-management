# PostgreSQL connection. Never commit real credentials.
PG_HOST=localhost
PG_PORT=5432
PG_USERNAME=postgres
PG_PASSWORD=your-password
PG_DATABASE=stockpilot_db

# Optional comma-separated CORS origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional frontend overrides are documented in frontend/.env.example
